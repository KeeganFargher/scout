{
  "name": "scout",
  "private": true,
  "workspaces": [
    "apps/*",
    "domains/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --build",
    "test": "node --test \"{apps,domains,packages}/*/src/**/*.test.ts\"",
    "check": "yarn format:check && yarn lint && yarn typecheck && yarn test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.18.1"
}
