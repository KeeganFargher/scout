+/// print several counts/filenames and reset `-m`. Only line-aligned plain text uses this;
+/// its finish metadata carries no binary offset and the printers do not request stats.
+struct BlockSink<S> {
+    sink: S,
+    matches: u64,
+    limit: Option<u64>,
+    keep_going: bool,
+    finish: Option<SinkFinish>,
+}
+
+impl<S: Sink<Error = std::io::Error>> Sink for BlockSink<S> {
+    type Error = std::io::Error;
+
+    fn matched(&mut self, searcher: &Searcher, mat: &SinkMatch<'_>) -> std::io::Result<bool> {
+        self.matches += 1;
+        self.keep_going = self.sink.matched(searcher, mat)? && self.limit.is_none_or(|n| self.matches < n);
+        Ok(self.keep_going)
+    }
+
+    fn finish(&mut self, _: &Searcher, finish: &SinkFinish) -> std::io::Result<()> {
+        self.finish = Some(finish.clone());
+        Ok(())
+    }
