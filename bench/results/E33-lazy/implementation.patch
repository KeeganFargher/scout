+    if opts.max_count == Some(0) {
+        return Ok(false);
+    }
+    let io = |e| Error::io(doc.path, e);
+    let keep_going = sink.begin(searcher).map_err(io)?;
+    let mut sink = BlockSink { sink, matches: 0, limit: opts.max_count, keep_going, finish: None };
+    if keep_going {
+        doc.shard.visit_content(doc.want, buf, &mut |bytes, first_line| {
+            check_deadline(opts)?;
+            searcher.set_first_line_number(first_line);
