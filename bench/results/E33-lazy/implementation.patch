+fn search_blocks<S: Sink<Error = std::io::Error>>(
+    searcher: &mut Searcher,
+    matcher: &RegexMatcher,
+    mut sink: S,
+    doc: IndexedDoc<'_>,
+    buf: &mut Vec<u8>,
+    opts: &SearchOptions,
