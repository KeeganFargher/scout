+
+    #[test]
+    fn projected_prefixes_never_reject_real_unicode_or_byte_edge_matches() {
+        use grep_matcher::Matcher;
+        use grep_regex::RegexMatcherBuilder;
+        let samples: &[&[u8]] = &[
+            b"2026-10-27",
+            "٢٠٢٦-١٠-٢٧".as_bytes(),
+            "２０２６-１０-２７".as_bytes(),
+            "αβγδ-１２".as_bytes(),
+            "2026�12".as_bytes(),
+            b"invalid\xff2026-10-27",
+            b"2026-10-27\xf0\x90",
+            b"2026\xff10-27",
+            b"abcd",
+            b"2026abcd",
+            b"1234-56\r\n2026-10-27\n",
+            b"word-1234",
+        ];
+        for pattern in [
+            r"\d{4}-\d{2}-\d{2}",
+            r"\p{Greek}{4}-\d{2}",
+            r"\d{4}�\d{2}",
+            r"(?:\d{4})?abcd",
+            r"\d{4}[-_]\d{2}",
+            r"\d{4}|abcd",
+            r"\b\d{4}-\d{2}",
+            r"\D{4}-\d{2}",
+        ] {
