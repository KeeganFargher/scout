+/// Appends the trigrams whose lists [`candidates`] may decode for `query` on `shard`, for
+/// [`Shard::prefetch_postings`] (E58): every list it decodes, and a few it may not. An
+/// AND's walk (E22) decodes a further list only while the decoding stays under the price
+/// of verifying the candidates left, which are known only as lists are decoded; but they
+/// never outnumber the rarest list, so with its count in their place the same walk stops
+/// at or after the real one. A list it takes that the real walk does not, because the
+/// candidates shrank first, or because an earlier part emptied the AND, is read for
+/// nothing; a list it leaves out the real walk never decodes.
+fn lists_to_decode(shard: &dyn Shard, query: &Query, out: &mut Vec<Trigram>) -> Result<()> {
+    match query {
+        Query::All => {}
+        Query::Tri(t) => out.push(*t),
+        Query::And(parts) => {
+            let mut tris = Vec::new();
+            for p in parts {
+                match p {
+                    Query::Tri(t) => tris.push(*t),
+                    _ => lists_to_decode(shard, p, out)?,
+                }
+            }
+            let Some(counted) = count_trigrams(shard, &tris)? else {
+                return Ok(());
+            };
+            let Some(&(rarest, _)) = counted.first() else {
+                return Ok(());
+            };
+            let budget = u64::from(rarest) * VERIFY_COST_POSTINGS;
+            let mut spent = 0u64;
+            for (i, &(n, t)) in counted.iter().enumerate() {
+                let cost = u64::from(n) + LIST_COST_POSTINGS;
+                if i > 0 && spent + cost > budget {
+                    break;
+                }
+                spent += cost;
+                out.push(t);
+            }
+        }
+        Query::Or(parts) => {
+            for p in parts.iter().filter(|p| may_match(shard, p)) {
+                lists_to_decode(shard, p, out)?;
+            }
+        }
+    }
+    Ok(())
+}
